# The externally reachable origin — the reverse proxy's URL, not the container's.
# OAuth issuer and resource identifiers derive from this and must match what the
# client fetched, so getting it wrong breaks discovery rather than degrading it.
MCPHUB_PUBLIC_URL=https://mcp.example.com

# Where hub.db and master.key live. Mount this as a volume and back it up.
MCPHUB_DATA_DIR=/data

MCPHUB_HOST=0.0.0.0
MCPHUB_PORT=8080

# Allows a non-HTTPS public URL. Local development only — bearer tokens would
# otherwise cross the network in the clear.
# MCPHUB_DEV=1
